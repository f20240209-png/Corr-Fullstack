  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://www.gstatic.com https://www.google.com https://www.recaptcha.net https://apis.google.com; connect-src 'self' https://glowguide-fullstack.onrender.com https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com https://www.gstatic.com https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; frame-src https://open.spotify.com https://*.firebaseapp.com https://*.web.app https://accounts.google.com https://www.google.com https://www.recaptcha.net; worker-src 'self' blob:; media-src 'self' blob: https://*.scdn.co; object-src 'none'; base-uri 'self'; frame-ancestors 'none'

/index.html
  Cache-Control: no-cache
/flutter_bootstrap.js
  Cache-Control: no-cache
/main.dart.js
  Cache-Control: no-cache
/flutter_service_worker.js
