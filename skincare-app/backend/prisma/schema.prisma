generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
  relationMode = "prisma"
}

model User {
  id               Int               @id @default(autoincrement())
  name             String?
  email            String?           @unique
  password         String?
  googleId         String?           @unique
  phoneNumber      String?           @unique
  isNewUser        Boolean           @default(true)
  username         String?           @unique  //
  usernameChangedAt DateTime?                 //  (null = never changed)
  createdAt        DateTime          @default(now())
  discoveries      ProductDiscovery[]
  journalEntries   JournalEntry[]
  profile          Profile?
  skincareLogs     SkincareLog[]
  communityPosts   CommunityPost[]
  communityAnswers CommunityAnswer[]
  sentRequests     FriendRequest[]   @relation("SentRequests")     // 
  receivedRequests FriendRequest[]   @relation("ReceivedRequests") // 
}

model Profile {
  id               Int      @id @default(autoincrement())
  userId           Int      @unique
  user             User     @relation(fields: [userId], references: [id])
  age              Int
  gender           String
  skinType         String
  skinGoals        String   @db.Text
  budget           Float
  currentProducts  String?  @db.Text
  currentRoutine   String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  recommendation   Recommendation?
}

model Recommendation {
  id                  Int      @id @default(autoincrement())
  profileId           Int      @unique
  profile             Profile  @relation(fields: [profileId], references: [id])
  routine             String   @db.LongText
  products            String   @db.LongText
  productAnalysis     String?  @db.LongText
  isEffective         Boolean  @default(false)
  hasCurrentProducts  Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String   @db.Text
  brand       String
  category    String
  price       Float    @default(0)
  originalPrice Float  @default(0)
  discount    String?
  skinTypes   String
  skinGoals   String
  description String   @db.Text
  howToUse    String   @db.Text
  availableAt String   @default("Nykaa, Amazon, Flipkart")
  rating      Float    @default(0)
  reviewCount Int      @default(0)
  ingredients String?  @db.LongText
  imageUrl    String?  @db.Text
  productUrl  String?  @db.Text
  createdAt   DateTime @default(now())
}
model SkincareLog {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id])
  timeOfDay    String
  productsUsed String   @db.Text
  notes        String?  @db.Text
  photo        String?  @db.LongText
  createdAt    DateTime @default(now())
}

model Ingredient_Conflict {
  id             Int      @id @default(autoincrement())
  ingredientA    String
  ingredientB    String
  severityLevel  String
  warningMessage String   @db.Text
  createdAt      DateTime @default(now())

  @@unique([ingredientA, ingredientB])
}

model CommunityPost {
  id          Int               @id @default(autoincrement())
  userId      Int
  user        User              @relation(fields: [userId], references: [id])
  question    String            @db.Text
  details     String?           @db.Text
  category    String
  skinType    String?
  isAnonymous Boolean           @default(true)
  likes       Int               @default(0)
  createdAt   DateTime          @default(now())
  answers     CommunityAnswer[]
}

model CommunityAnswer {
  id          Int           @id @default(autoincrement())
  postId      Int
  post        CommunityPost @relation(fields: [postId], references: [id])
  userId      Int
  user        User          @relation(fields: [userId], references: [id])
  answer      String        @db.Text
  isAnonymous Boolean       @default(true)
  isHelpful   Int           @default(0)
  createdAt   DateTime      @default(now())
}

model FriendRequest {
  id         Int      @id @default(autoincrement())
  senderId   Int
  receiverId Int
  status     String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sender   User @relation("SentRequests",     fields: [senderId],   references: [id])
  receiver User @relation("ReceivedRequests", fields: [receiverId], references: [id])

  @@unique([senderId, receiverId])
}

model ProductDiscovery {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id])
  productName  String   @db.VarChar(120)
  brand        String   @db.VarChar(80)
  productType  String   @default("other") @db.VarChar(30)
  productKey   String   @db.Char(64)
  imageHash    String   @db.Char(64)
  review       String   @db.Text
  rating       Int?
  discoveredOn String   @db.Char(10)
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  image        ProductDiscoveryImage?

  @@unique([userId, productKey])
  @@unique([userId, imageHash])
  @@index([userId, id])
}

model ProductDiscoveryImage {
  discoveryId Int      @id
  discovery   ProductDiscovery @relation(fields: [discoveryId], references: [id], onDelete: Cascade)
  bytes       Bytes    @db.MediumBlob
  thumbnail   Bytes    @db.MediumBlob
}

model JournalEntry {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  entryDate String   @db.Char(10)
  title     String   @db.VarChar(120)
  body      String   @db.Text
  spotifyTrackId String? @db.VarChar(22)
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  image     JournalEntryImage?

  @@unique([userId, entryDate])
}

model JournalEntryImage {
  entryId   Int      @id
  entry     JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  bytes     Bytes    @db.MediumBlob
  thumbnail Bytes    @db.MediumBlob
}
